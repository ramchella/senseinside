{
  "name": "@senseinside/core",
  "version": "0.1.0",
  "description": "SenseInside core: schemas, prompt, brain reader, LLM client.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./schema": {
      "import": "./dist/sensecheck/schema.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "eval": "tsx src/sensecheck/eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "gray-matter": "^4.0.3",
    "lru-cache": "^11.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
