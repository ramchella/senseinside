{
  "name": "sense-inside",
  "version": "0.0.0",
  "private": true,
  "description": "SenseInside — runtime identity governance for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @senseinside/core && npm run build -w @senseinside/hook && npm run build -w @senseinside/cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome format --write .",
    "eval": "npm run eval --workspace @senseinside/core",
    "release-check": "tsx scripts/release.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
